# Copy this file to opensign/.env and replace every empty required value.
# The generated opensign/.env file is ignored by Git.
# Single-quote values containing $, #, or spaces so Compose treats them literally.

# --- Public endpoints ---
D6E_DOMAIN=app.example.com
OPENSIGN_DOMAIN=sign.example.com
TLS_EMAIL=admin@example.com

# --- Reproducible images (refreshed 2026-09-08) ---
OPENSIGN_SERVER_IMAGE=opensign/opensignserver:main@sha256:cadfcaaa20bf40272aed43c91314362c1dac034b2a4651f50e5288d01c2b434d
OPENSIGN_CLIENT_IMAGE=opensign/opensign:main@sha256:0ebc230eed21ced0d321a0df887c1a48e9f4bd423c2454fe865a262aec49f99a
OPENSIGN_MONGO_IMAGE=mongo:8.0@sha256:02a0cc7939f5ed38f30f9bc714ef5f682d49baf9350c54acf302ce833087fe8a

# Use URL-safe values because these credentials are embedded in MONGODB_URI.
OPENSIGN_MONGO_ROOT_USERNAME=opensign
OPENSIGN_MONGO_ROOT_PASSWORD=

# OpenSign application secret. Generate independently from the MongoDB password.
OPENSIGN_MASTER_KEY=
OPENSIGN_APP_NAME='d6e OpenSign'

# SMTP is required for invitations, verification, and password reset.
OPENSIGN_SMTP_HOST=
OPENSIGN_SMTP_PORT=587
OPENSIGN_SMTP_USER_EMAIL=
OPENSIGN_SMTP_USERNAME=
OPENSIGN_SMTP_PASS=''

# Base64-encoded PKCS#12 signing certificate and its passphrase.
OPENSIGN_PFX_BASE64=
OPENSIGN_PFX_PASSPHRASE=''
