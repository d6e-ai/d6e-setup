# --- Database ---
# POSTGRES_* vars: compose.withdb.yml only. DATABASE_URL: compose.yml (external DB).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=d6e
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:your-secure-password@db:5432/d6e

# --- Services ---
API_PORT=8080
MCP_PORT=8081
FRONTEND_PORT=3000
D6E_API_URL=http://api:8080
D6E_MCP_SERVER_URL=http://mcp:8081/mcp
ORIGIN=http://localhost:3000

# --- Authentication (d6e-auth) ---
# JWKS endpoint: D6E_AUTH_URL/.well-known/jwks.json
# SaaS OAuth (MoneyForward, etc.) is managed by d6e-auth, not here.
D6E_AUTH_URL=https://www.d6e.ai
D6E_AUTH_CLIENT_ID=your-client-id
D6E_AUTH_CLIENT_SECRET=your-client-secret
D6E_AUTH_JWT_ISSUER=d6e-auth

# --- AI ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
TAVILY_API_KEY=tvly-...                          # https://tavily.com
EMBEDDING_MODEL=gemini-embedding-2-preview        # requires GOOGLE_API_KEY
EMBEDDING_DIMENSIONS=768                          # max 2000 for HNSW indexing

# --- Security ---
# Generate secrets with: openssl rand -base64 32
D6E_CONTAINER_TOKEN_SECRET=d6e-container-secret-dev-key
SAAS_CREDENTIAL_ENCRYPTION_KEY=

# --- Admin ---
# Leave ADMIN_PASSWORD empty to disable /admin entirely.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
WORKSPACE_CREATION_OPEN=false

# --- App Marketplace ---
PUBLIC_MARKETPLACE_URL=https://marketplace.d6e.ai
MARKETPLACE_REGISTRY_URL=https://marketplace.d6e.ai/api/registry
