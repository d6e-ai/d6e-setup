# --- Database ---
# POSTGRES_* vars: compose.withdb.yml only. DATABASE_URL: compose.yml (external DB).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=d6e
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:your-secure-password@db:5432/d6e

# --- Services ---
API_PORT=8080
MCP_PORT=8081
FRONTEND_PORT=3000
D6E_API_URL=http://api:8080
D6E_MCP_SERVER_URL=http://mcp:8081/mcp
ORIGIN=http://localhost:3000

# --- Authentication (d6e-auth) ---
# JWKS endpoint: D6E_AUTH_URL/.well-known/jwks.json
# SaaS OAuth (MoneyForward, etc.) is managed by d6e-auth, not here.
D6E_AUTH_URL=https://www.d6e.ai
D6E_AUTH_CLIENT_ID=your-client-id
D6E_AUTH_CLIENT_SECRET=your-client-secret
D6E_AUTH_JWT_ISSUER=d6e-auth
# NOTE: ALLOWED_REDIRECT_URIS is deprecated and no longer read by the d6e
# API (d6e >= workspace-scoped redirect URI release). OAuth redirect URIs
# for custom frontends are managed in d6e-auth:
#   - instance-wide: franchise portal -> instance card -> Redirect URIs
#   - per-workspace: d6e console -> Workspace Settings -> Integration ->
#     Redirect URIs (issues workspace-scoped tokens)
# Loopback URLs (localhost / 127.0.0.0/8 / [::1], any port) need no
# registration. The built-in console callback (${ORIGIN}/auth/callback)
# is registered instance-wide when the administrator runs register-client.

# --- AI ---
# All cloud LLM calls — chat completion AND embeddings — route through
# the Vercel AI Gateway. The instance uses a per-instance virtual gateway
# key that d6e-auth issues and stores in `instance_gateway_key`; the
# local AI_GATEWAY_API_KEY env var is an explicit fallback only used in
# dev / when the d6e-auth-managed key has not been provisioned yet.
#
# Token accounting is no longer measured on the instance: every request
# is tagged via the Gateway's `ai-reporting-user` / `ai-reporting-tags`
# headers (`workspace:<id>,instance:<id>,kind:<kind>,user:<userId>`),
# and d6e-auth's cron pulls authoritative spend from the Gateway's
# Custom Reporting API on a fixed interval.
#
# Individual provider keys (OPENAI_API_KEY / ANTHROPIC_API_KEY /
# GOOGLE_API_KEY) MUST NOT be set on the instance — those credentials are
# now held centrally inside the Vercel AI Gateway project that d6e-auth
# manages. Setting them here is a no-op.
AI_GATEWAY_API_KEY=
# Local LLM (Ollama / LM Studio): opt-in — set BASE_URL to enable; the full
# OpenAI-compatible URL (with /v1 suffix) is sent to the provider verbatim.
# MODELS (JSON) optionally overrides /v1/models discovery; entry fields: model
# (required), label, context. MODELS alone does NOT enable a provider.
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# OLLAMA_MODELS=[{"model":"llama3.3","label":"Llama 3.3 70B","context":131072}]
# LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
# LM_STUDIO_MODELS=[{"model":"openai/gpt-oss-20b","label":"GPT OSS 20B","context":131072}]
TAVILY_API_KEY=tvly-...                          # https://tavily.com
# Embeddings hit the Gateway directly at `/v1/embeddings` (OpenAI-compat),
# routed by the model id below. Multimodal payloads for
# `gemini-embedding-2-*` are sent via `providerOptions.google.content`
# with base64 `inlineData` parts. Only the model id and output
# dimensionality are configured here; the gateway key resolution is
# handled by the same AI_GATEWAY_API_KEY / d6e-auth fetch path above.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768                          # max 2000 for HNSW indexing

# --- Security ---
# Generate secrets with: openssl rand -base64 32
D6E_CONTAINER_TOKEN_SECRET=d6e-container-secret-dev-key
SAAS_CREDENTIAL_ENCRYPTION_KEY=

# --- Admin ---
# Leave ADMIN_PASSWORD empty to disable /admin entirely.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
# WORKSPACE_CREATION_OPEN is no longer consulted: all authenticated
# users may create workspaces, and billing is provisioned per-workspace
# in d6e-auth as a 14-day trial subscription. Kept here as a comment so
# operators upgrading from older releases see that they can stop setting
# it.
# WORKSPACE_CREATION_OPEN=true

# --- Plugin Marketplace ---
PUBLIC_MARKETPLACE_URL=https://marketplace.d6e.ai
MARKETPLACE_REGISTRY_URL=https://marketplace.d6e.ai/api/registry

# --- Docker STF Execution ---
# Concurrency: max simultaneous containers per API process (minimum 1)
STF_DOCKER_MAX_CONCURRENT=2
# Execution timeout in seconds (measured after acquiring a container slot)
STF_DOCKER_TIMEOUT_SECS=300
# Max stdout/stderr bytes before killing the container (default 10 MB)
# STF_DOCKER_MAX_OUTPUT_BYTES=10485760
# Per-container resource limits (values passed directly to `docker run` flags)
# STF_DOCKER_MEMORY_LIMIT=1g
# STF_DOCKER_CPUS=1.0
# STF_DOCKER_PIDS_LIMIT=256
# Internal API URL containers use to reach the API server
# D6E_API_URL_FOR_DOCKER=http://host.docker.internal:8080

# --- Context Compaction ---
# Opencode-style prune + LLM summary. Lower values = more aggressive compression.
D6E_COMPACTION_AUTO=true
D6E_COMPACTION_PRUNE=true
D6E_COMPACTION_PRUNE_PROTECT=60000                # recent-activity token budget (opencode: 40000)
D6E_COMPACTION_PRUNE_MINIMUM=30000                # skip prune below this (opencode: 20000)
D6E_COMPACTION_PROTECT_TURNS=4                    # user turns never pruned (opencode: 2)
# D6E_COMPACTION_RESERVED=                       # optional: pin reserved for all models (unset = per-model value from limits.ts)
D6E_COMPACTION_LARGE_TOOL_RESULT_THRESHOLD=20000  # prune single oversized tool result (0=off)
# D6E_COMPACTION_MODEL=                             # "provider/model" override; empty = lightweight default (Haiku/Nano/Flash) per provider
# D6E_TITLE_MODEL=                                  # "provider/model" override for chat session title generation; empty = lightweight default per provider
