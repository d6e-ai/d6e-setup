# --- Database ---
# POSTGRES_* vars: compose.withdb.yml only. DATABASE_URL: compose.yml (external DB).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=d6e
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:your-secure-password@db:5432/d6e

# --- Services ---
API_PORT=8080
MCP_PORT=8081
FRONTEND_PORT=3000
D6E_API_URL=http://api:8080
D6E_MCP_SERVER_URL=http://mcp:8081/mcp
ORIGIN=http://localhost:3000

# Per-page Tesseract on PDF JPEGs from d6e_view_image / d6e_extract_file_text.
# Default is off: Vision reads the page images. Set to 1 to attach OCR text.
# MCP_PDF_PAGE_OCR=1

# --- Authentication (d6e-auth) ---
# JWKS endpoint: D6E_AUTH_URL/.well-known/jwks.json
# SaaS OAuth (MoneyForward, etc.) is managed by d6e-auth, not here.
D6E_AUTH_URL=https://www.d6e.ai
D6E_AUTH_CLIENT_ID=your-client-id
D6E_AUTH_CLIENT_SECRET=your-client-secret
D6E_AUTH_JWT_ISSUER=d6e-auth
# The D6E console (www.d6e.ai/{locale}/console) calls this API from the
# browser. Origins allowed to read its answers (CORS, comma-separated); unset
# means the origin of D6E_AUTH_URL, empty turns it off.
# D6E_CONSOLE_ORIGINS=https://www.d6e.ai
# The D6E console that has the management pages (workspaces, runs, data,
# workflows, settings, Voice and the rest). Since D6E v2.1.0 the frontend has
# only the AI chat, /admin and sign-in, and sends the other pages' addresses
# there. Unset means D6E_AUTH_URL.
D6E_CONSOLE_URL=https://www.d6e.ai
# NOTE: ALLOWED_REDIRECT_URIS is deprecated and no longer read. OAuth
# redirect URIs for custom frontends are managed in d6e-auth (franchise
# portal -> instance card -> Redirect URIs) and per-workspace from the
# d6e instance console (Workspace Settings -> Integration -> Redirect URIs).

# --- AI ---
# Every AI call — chat, workflows, titles, memory, embeddings, the voice
# agent's delegate, transcription, web search (Tavily) and ephemeral
# executions — goes to the AI entry run by d6e.ai, which bills a D6E wallet.
# The key: a workspace's own D6E key (set from the D6E console) or, otherwise,
# this server's own key, which the server takes from d6e.ai with
# D6E_AUTH_URL / D6E_AUTH_CLIENT_ID / D6E_AUTH_CLIENT_SECRET and keeps
# encrypted in the database (SAAS_CREDENTIAL_ENCRYPTION_KEY). There is no AI
# key to set here. AI_GATEWAY_API_KEY, AI_GATEWAY_BASE_URL,
# D6E_AI_GATEWAY_BASE_URL and TAVILY_API_KEY are no longer read; remove them.
# D6E_AI_ENTRY_URL=https://www.d6e.ai            # http only for a local stand-in
# D6E_AI_ENTRY_KEY_ENVIRONMENT=live              # test: the entry's mock upstream only
# Default models, as provider/model (ids the entry resolves). Chat titles,
# compaction summaries, memories and verification use the small model of the
# chat's provider (openai gpt-6-luna, anthropic claude-haiku-5-5, ...; memories
# follow D6E_MEMORY_PROVIDER, default anthropic) unless D6E_AI_FAST_MODEL sets
# one model for all of them. The smart model is the chat and SNS default of new
# workspaces (and of a reset) and the workflow fallback. D6E_TITLE_MODEL and
# D6E_COMPACTION_MODEL below still override the fast model for their task.
# D6E_AI_FAST_MODEL=
# D6E_MEMORY_PROVIDER=anthropic                   # anthropic or openai
# D6E_AI_SMART_MODEL=anthropic/claude-sonnet-5-5
# Embedding model (an id of the entry's catalogue) and its dimensions.
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSIONS=768                          # max 2000 for HNSW indexing

# --- Security ---
# Generate secrets with: openssl rand -base64 32
D6E_CONTAINER_TOKEN_SECRET=d6e-container-secret-dev-key
SAAS_CREDENTIAL_ENCRYPTION_KEY=

# --- Admin ---
# Leave ADMIN_PASSWORD empty to disable /admin entirely.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# API-key UUID to product-namespace bindings allowed to use the external
# workspace provisioning API. Comma-separate additional bindings. The raw API
# key remains the Bearer credential and must not be placed in this setting.
# D6E_WORKSPACE_PROVISIONERS=00000000-0000-0000-0000-000000000000=lease-manager

# --- Plugin Marketplace ---
PUBLIC_MARKETPLACE_URL=https://marketplace.d6e.ai
MARKETPLACE_REGISTRY_URL=https://marketplace.d6e.ai/api/registry

# --- Async intent jobs (execute-by-intent background runner) ---
# Max running jobs per workspace (minimum 1). Default 8.
# Clients can read the live value from GET /api/workflows/execute-by-intent/jobs/limits
# INTENT_JOB_MAX_RUNNING_PER_WORKSPACE=8
# Wall-clock abort for a single job in milliseconds (default 1800000 = 30 min)
# INTENT_JOB_TIMEOUT_MS=1800000

# --- Ephemeral executions ---
# Private server-side registry. The HTTP caller can select only a profile name;
# provider configuration and policy never come from the request. Each profile
# must explicitly list a maximum execution duration, permitted workspaces, exact
# commands, and environment names. maxExecutionSeconds is required, positive,
# and expressed in seconds. Provider-specific validation is documented with its
# adapter.
# D6E_EPHEMERAL_EXECUTION_PROFILES_JSON=[{"name":"example-runtime","provider":{"kind":"ecs-fargate","configuration":{"region":"ap-northeast-1","clusterArn":"arn:aws:ecs:ap-northeast-1:123456789012:cluster/example","taskDefinitionArn":"arn:aws:ecs:ap-northeast-1:123456789012:task-definition/example:1","containerName":"execution","subnetIds":["subnet-example"],"securityGroupIds":["sg-example"],"assignPublicIp":"DISABLED"}},"maxExecutionSeconds":1800,"allowedWorkspaceIds":["00000000-0000-4000-8000-000000000000"],"allowedCommands":[["python3","-m","example.runtime"]],"environmentNames":["INPUT_URL","OUTPUT_URL"],"reservedEnvironmentNames":["RUNTIME_AUTH_JSON"],"enabled":true}]

# --- Docker STF Execution ---
# Concurrency: max simultaneous containers per API process (minimum 1)
STF_DOCKER_MAX_CONCURRENT=2
# Execution timeout in seconds (measured after acquiring a container slot)
STF_DOCKER_TIMEOUT_SECS=300
# Max stdout/stderr bytes before killing the container (default 10 MB)
# STF_DOCKER_MAX_OUTPUT_BYTES=10485760
# Per-container resource limits (values passed directly to `docker run` flags)
# STF_DOCKER_MEMORY_LIMIT=1g
# Ceiling for a plugin that sets its own memory (for example report-generator: 8g).
# STF_DOCKER_MEMORY_MAX=16g
# STF_DOCKER_CPUS=1.0
# STF_DOCKER_PIDS_LIMIT=256
# Internal API URL containers use to reach the API server
# D6E_API_URL_FOR_DOCKER=http://host.docker.internal:8080

# --- Context Compaction ---
# Opencode-style prune + LLM summary. Lower values = more aggressive compression.
D6E_COMPACTION_AUTO=true
D6E_COMPACTION_PRUNE=true
D6E_COMPACTION_PRUNE_PROTECT=60000                # recent-activity token budget (opencode: 40000)
D6E_COMPACTION_PRUNE_MINIMUM=30000                # skip prune below this (opencode: 20000)
D6E_COMPACTION_PROTECT_TURNS=4                    # user turns never pruned (opencode: 2)
# D6E_COMPACTION_RESERVED=                       # optional: pin reserved for all models (unset = per-model value from limits.ts)
D6E_COMPACTION_LARGE_TOOL_RESULT_THRESHOLD=20000  # prune single oversized tool result (0=off)
# D6E_COMPACTION_MODEL=                             # "provider/model" override; empty = the fast model (D6E_AI_FAST_MODEL)
# D6E_COMPACTION_PROMPT=                            # optional full replacement of the summary instruction; empty = built-in handoff template
# D6E_TITLE_MODEL=                                  # "provider/model" override for chat session title generation; empty = the fast model (D6E_AI_FAST_MODEL)

# --- D6E Voice (GPT-Live: OpenAI Direct SIP + sideband, optional Telnyx B-hybrid outbound; d6e never handles audio) ---
# Instance-wide switches. Each must be exactly "true"; there is no per-workspace on/off flag.
# D6E_VOICE_LIVE_ENABLED=false                    # master switch: the OpenAI and Telnyx webhook routes, the worker and the frontend Voice menu
# D6E_VOICE_LIVE_OUTBOUND_ENABLED=false           # outbound calls (each one still needs human approval)
# D6E_VOICE_LIVE_INBOUND_ENABLED=false            # inbound calls
# D6E_VOICE_PUBLIC_ORIGIN=https://d6e.example.com # https origin only; the OpenAI webhook URL is built from it
# See the D6E voice documentation.

# Optional instance-wide fallback for workspaces whose live connection uses key_source=instance:
# D6E_VOICE_OPENAI_API_KEY=
# D6E_VOICE_OPENAI_PROJECT_ID=
# D6E_VOICE_OPENAI_WEBHOOK_SECRET=                # whsec_... signing secret of the OpenAI project webhook
# D6E_VOICE_OPENAI_BASE_URL=https://api.openai.com # https only (http allowed for loopback test mocks)

# Telnyx bridge (B-hybrid) outbound provider, used only by live connections set to outbound_provider=telnyx_bridge.
# Without these a telnyx_bridge dispatch fails before anything is dialed. Never commit values.
# D6E_VOICE_TELNYX_API_KEY=
# D6E_VOICE_TELNYX_PUBLIC_KEY=                    # base64 Ed25519 public key that signs Telnyx webhooks (Telnyx portal > Keys & Credentials)
# D6E_VOICE_PUBLIC_BASE_URL=https://d6e.example.com # https origin of this API; the per-call Telnyx webhook URL is built from it
# D6E_VOICE_TELNYX_BASE_URL=https://api.telnyx.com # https only (http allowed for loopback test mocks)
# D6E_VOICE_TELNYX_MAX_CALL_SECONDS=900           # backstop time limit for both legs (max 14400)
# D6E_VOICE_OUTBOUND_GREETING_AFTER_BRIDGE=true   # pre-dialed outbound: hold the opening until the legs are bridged (default true); false/0/off/no = v0.33.2 behaviour (opening hint on the accept)
# D6E_VOICE_OUTBOUND_PACE_HINT=                   # optional text appended to the outbound greeting hint only (pace wording, max 300 bytes, control characters stripped); empty = no change

# Voice usage reporting to d6e.ai, which bills voice by the minute and each 050
# number held. An RFC 3339 time; setting it turns reporting on. Calls that ended
# before it are never reported and no number is billed for the time before it.
# It needs D6E_AUTH_URL (https), D6E_AUTH_CLIENT_ID and D6E_AUTH_CLIENT_SECRET.
# If this server runs the LiveKit voice agent (d6e-voice-agent), upgrade the
# agent first and set this time after it is up: a LiveKit call handled by an
# older agent has no seconds and is skipped for good.
# D6E_VOICE_USAGE_REPORT_SINCE=2026-12-01T00:00:00Z
